DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cacic_voto"
REDIS_URL="redis://localhost:6379/0"
SSE_REPLAY_CURSOR_SECRET="local-development-sse-replay-secret"
SWAGGER_ENABLED="false"
PUBLIC_ORIGIN="http://localhost:4200"
TRUST_PROXY_HOPS="0"
KEYCLOAK_REQUEST_TIMEOUT_MS="10000"
KEYCLOAK_PRINCIPAL_CACHE_MAX_ENTRIES="1000"
KEYCLOAK_AUTH_REFRESH_LOCK_TTL_MS="30000"
KEYCLOAK_AUTH_REFRESH_LOCK_WAIT_MS="15000"
KEYCLOAK_AUTH_REFRESH_LOCK_RENEWAL_MS="5000"

KEYCLOAK_REALM_URL="https://sso.cacic.com.br/realms/cacic-sso"
KEYCLOAK_CLIENT_ID="cacic-voto"
KEYCLOAK_CLIENT_SECRET=""
KEYCLOAK_REDIRECT_URI="http://localhost:4200/api/auth/callback"
KEYCLOAK_POST_LOGIN_REDIRECT_URI="http://localhost:4200"
KEYCLOAK_POST_LOGOUT_REDIRECT_URI="http://localhost:4200/"
KEYCLOAK_ALLOWED_CALLBACK_REDIRECT_ORIGINS="http://localhost:4200,http://localhost:3000"
KEYCLOAK_ALLOWED_POST_LOGIN_REDIRECT_ORIGINS="http://localhost:4200"
KEYCLOAK_ALLOWED_POST_LOGOUT_REDIRECT_ORIGINS="http://localhost:4200"
KEYCLOAK_AUTH_SESSION_REDIS_PREFIX="cacic-voto:auth:session:"
KEYCLOAK_AUTH_STATE_REDIS_PREFIX="cacic-voto:auth:oauth-state:"

# Machine-to-machine client used by CACiC Voto when calling sister services.
KEYCLOAK_M2M_CLIENT_ID="cacic-voto-m2m"
KEYCLOAK_M2M_CLIENT_SECRET=""

# Listener used by Account Manager to process LGPD exports and account deletions.
# Its service account needs lgpd:read and lgpd:delete realm roles in CACiC Voto.
VOTING_GRPC_BIND_URL="0.0.0.0:50051"
LGPD_M2M_ALLOWED_CLIENTS="cacic-account-manager-m2m"
LGPD_ANONYMIZATION_SECRET="local-development-lgpd-anonymization-secret"

# S3-compatible object storage used for poll images.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="cacic-voto"
S3_REGION="us-east-1"
S3_REQUIRED="false"
S3_REQUEST_TIMEOUT_MS="15000"
S3_DELETE_RETRY_ATTEMPTS="3"

# Event Manager integration target. The service account needs the
# voting-integration:read role in Event Manager.
EVENT_MANAGER_GRPC_URL="localhost:50052"
EVENT_MANAGER_M2M_AUDIENCE="cacic-event-manager-api"
# EVENT_MANAGER_M2M_SCOPE=""

# Account Manager integration target. The service account needs users:read and
# totp:validate on the Account Manager M2M audience. Never grant totp:relay.
ACCOUNT_MANAGER_GRPC_URL="localhost:50053"
ACCOUNT_MANAGER_M2M_AUDIENCE="cacic-account-manager-audience"
# ACCOUNT_MANAGER_M2M_SCOPE=""

# Short-lived, single-use kiosk authorization and anti-brute-force limits.
POLL_KIOSK_AUTHORIZATION_TTL_SECONDS="600"
POLL_KIOSK_ATTEMPT_WINDOW_SECONDS="300"
POLL_KIOSK_SESSION_ATTEMPT_LIMIT="5"
POLL_KIOSK_GLOBAL_EMAIL_ATTEMPT_LIMIT="15"

# Optional. Set this when Keycloak should force a specific identity provider.
# KEYCLOAK_IDP_HINT="google"
