{
  "name": "backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend-e2e/src",
  "tags": ["scope:api"],
  "implicitDependencies": ["backend"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/backend-e2e"
      ],
      "options": {
        "passWithNoTests": true
      }
    },
    "e2e-keycloak": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/backend-e2e"],
      "options": {
        "command": "node tools/run-backend-keycloak-e2e.mjs",
        "forwardAllArgs": true
      }
    },
    "e2e-database": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/backend-database-integration"],
      "options": {
        "command": "bunx jest --config apps/backend-e2e/jest.database.config.cts --runInBand",
        "forwardAllArgs": true
      }
    }
  }
}
