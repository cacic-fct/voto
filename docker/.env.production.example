# Production environment for the server-FCTDTIWEBXP01 CACiC Voto stack.
# Copy this file to the secrets repository as
# docker-compose/cacic-voto/.env, replacing every value marked CHANGE_ME.

POSTGRES_DB=cacic_voto
POSTGRES_USER=cacic_voto
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://cacic_voto:CHANGE_ME_WITH_THE_SAME_DATABASE_PASSWORD@voto-db:5432/cacic_voto
REDIS_URL=redis://voto-redis:6379/0
SSE_REPLAY_CURSOR_SECRET=CHANGE_ME_WITH_A_RANDOM_SSE_CURSOR_SECRET

SWAGGER_ENABLED=false

KEYCLOAK_REALM_URL=https://sso.cacic.com.br/realms/cacic-sso
KEYCLOAK_CLIENT_ID=cacic-voto
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_WITH_THE_CACIC_VOTO_CLIENT_SECRET
KEYCLOAK_REDIRECT_URI=https://voto.cacic.com.br/api/auth/callback
KEYCLOAK_POST_LOGIN_REDIRECT_URI=https://voto.cacic.com.br/
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://voto.cacic.com.br/
KEYCLOAK_ALLOWED_CALLBACK_REDIRECT_ORIGINS=https://voto.cacic.com.br
KEYCLOAK_ALLOWED_POST_LOGIN_REDIRECT_ORIGINS=https://voto.cacic.com.br
KEYCLOAK_ALLOWED_POST_LOGOUT_REDIRECT_ORIGINS=https://voto.cacic.com.br
KEYCLOAK_AUTH_SESSION_REDIS_PREFIX=cacic-voto:auth:session:
KEYCLOAK_AUTH_STATE_REDIS_PREFIX=cacic-voto:auth:oauth-state:

# The cacic-voto-m2m service account must be permitted by both receivers:
# Event Manager: voting-integration:read
# Account Manager: users:read
KEYCLOAK_M2M_CLIENT_ID=cacic-voto-m2m
KEYCLOAK_M2M_CLIENT_SECRET=CHANGE_ME_WITH_THE_CACIC_VOTO_M2M_CLIENT_SECRET
VOTING_GRPC_BIND_URL=0.0.0.0:50051
LGPD_M2M_ALLOWED_CLIENTS=cacic-account-manager-m2m
EVENT_MANAGER_GRPC_URL=events-backend:50051
EVENT_MANAGER_M2M_AUDIENCE=cacic-event-manager-audience
# EVENT_MANAGER_M2M_SCOPE=
ACCOUNT_MANAGER_GRPC_URL=cacic-account-manager-backend:50051
ACCOUNT_MANAGER_M2M_AUDIENCE=cacic-account-manager-audience
# ACCOUNT_MANAGER_M2M_SCOPE=

# These defaults are already built into the backend. Set them only when a
# different Unleash frontend API/key is intentionally required.
# UNLEASH_FRONTEND_API_URL=https://unleash.cacic.com.br/api/frontend
# UNLEASH_FRONTEND_CLIENT_KEY=
# UNLEASH_APP_NAME=cacic-voto-backend
# UNLEASH_ENVIRONMENT=production
